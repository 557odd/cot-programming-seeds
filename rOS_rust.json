  "edge_cases": [
    {
      "case": "Borrow checker rejection",
      "handling": "Restructure ownership, borrowing, lifetimes, or data representation rather than bypassing the checker without establishing equivalent invariants."
    },
    {
      "case": "Self-referential structures",
      "handling": "Recognize that ordinary Rust references make many self-referential designs difficult; consider ownership indirection, pinning, or alternative representations."
    },
    {
      "case": "Reference cycles",
      "handling": "Use appropriate ownership graphs such as Rc with Weak when strong reference cycles would prevent destruction."
    },
    {
      "case": "Deadlock",
      "handling": "Design lock ordering, minimize lock scope, and consider message passing or lock-free approaches where appropriate."
    },
    {
      "case": "Async blocking",
      "handling": "Avoid blocking operations on asynchronous executor threads unless the runtime explicitly supports or isolates them."
    },
    {
      "case": "Unsafe code",
      "handling": "Document safety invariants and keep unsafe boundaries small and auditable."
    },
    {
      "case": "FFI panic crossing",
      "handling": "Do not allow incompatible panic behavior to cross foreign ABI boundaries without deliberate handling."
    },
    {
      "case": "Integer overflow",
      "handling": "Understand debug and release behavior and explicitly choose checked, wrapping, saturating, or overflowing operations when required."
    },
    {
      "case": "Trait object limitations",
      "handling": "Check object-safety requirements before using a trait as dyn Trait."
    },
    {
      "case": "Large async state machines",
      "handling": "Consider boxing, decomposition, or alternative state representations when future types become excessively large."
    },
    {
      "case": "Dependency feature interactions",
      "handling": "Audit enabled Cargo features and transitive dependencies to avoid unexpected code inclusion or conflicting configurations."
    }
  ],
  "constraints": [
    "Safe Rust must not rely on undefined behavior.",
    "Unsafe Rust requires explicit justification through documented invariants.",
    "Ownership and borrowing rules cannot be bypassed merely to silence compiler diagnostics.",
    "Public APIs should expose stable and understandable ownership semantics.",
    "Concurrency abstractions must preserve the required Send, Sync, and synchronization guarantees.",
    "FFI boundaries must account for ABI, representation, ownership, lifetime, and error-handling differences.",
    "Performance optimization should be driven by measurement rather than assumptions.",
    "Dependencies should be reviewed for licensing, security, maintenance, and feature implications.",
    "Async code should distinguish cooperative asynchronous execution from blocking work.",
    "Production code should use reproducible dependency and toolchain configuration."
  ],
