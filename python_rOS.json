  "edge_cases": [
    {
      "case": "Mutable default arguments",
      "handling": "Avoid mutable objects as default parameter values when per-call state is intended; use None or an appropriate factory."
    },
    {
      "case": "Late-binding closures",
      "handling": "Be explicit about captured loop variables when creating callbacks in loops."
    },
    {
      "case": "Floating-point precision",
      "handling": "Do not assume binary floating-point represents all decimal values exactly; use Decimal or domain-specific representations when required."
    },
    {
      "case": "Unicode boundaries",
      "handling": "Define explicit encoding and decoding boundaries and avoid implicit platform-dependent encodings."
    },
    {
      "case": "Circular imports",
      "handling": "Refactor dependency direction, move shared abstractions, or defer imports only when justified."
    },
    {
      "case": "Resource leaks",
      "handling": "Use context managers or explicit cleanup for files, sockets, locks, and external resources."
    },
    {
      "case": "Broad exception handling",
      "handling": "Avoid catching Exception or BaseException unless the boundary has a deliberate recovery or reporting purpose."
    },
    {
      "case": "Async blocking",
      "handling": "Do not perform long-running blocking operations directly on an event-loop thread without an appropriate strategy."
    },
    {
      "case": "Shared mutable state",
      "handling": "Use explicit synchronization or isolate state across execution contexts."
    },
    {
      "case": "Unsafe serialization",
      "handling": "Never treat untrusted pickle or equivalent executable serialization as ordinary data."
    },
    {
      "case": "Shell command injection",
      "handling": "Prefer argument arrays and avoid shell interpretation for untrusted input."
    },
    {
      "case": "Path traversal",
      "handling": "Normalize and validate user-controlled paths against an intended filesystem root."
    },
    {
      "case": "Dependency conflicts",
      "handling": "Use isolated environments and reproducible dependency specifications."
    },
    {
      "case": "Implementation-specific behavior",
      "handling": "Distinguish Python language guarantees from CPython-specific behavior before depending on it."
    }
  ],
