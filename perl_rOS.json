  "edge_cases": [
    {
      "case": "undef versus false",
      "handling": "Distinguish undefined values from other false values when absence has semantic meaning."
    },
    {
      "case": "scalar versus list context",
      "handling": "Verify the caller's context before assuming a subroutine receives or returns a particular shape."
    },
    {
      "case": "numeric versus string comparison",
      "handling": "Use numeric operators for numeric semantics and string operators for textual semantics."
    },
    {
      "case": "autovivification",
      "handling": "Be aware that nested dereferencing can implicitly create intermediate structures."
    },
    {
      "case": "regex catastrophic backtracking",
      "handling": "Constrain pattern complexity and untrusted input where resource exhaustion is possible."
    },
    {
      "case": "Unicode boundary errors",
      "handling": "Keep character processing and byte I/O conceptually separate and encode/decode explicitly at boundaries."
    },
    {
      "case": "shell metacharacters",
      "handling": "Avoid unintended shell interpretation and prefer safe argument-list execution."
    },
    {
      "case": "global package variables",
      "handling": "Prefer lexical variables unless package-level state is intentionally required."
    },
    {
      "case": "exception capture",
      "handling": "Capture and inspect $@ immediately because subsequent operations can alter diagnostic state."
    },
    {
      "case": "system exit status",
      "handling": "Interpret $? carefully rather than treating it as a simple boolean."
    },
    {
      "case": "cyclic references",
      "handling": "Use weak references or explicit lifecycle management where reference cycles would prevent expected cleanup."
    },
    {
      "case": "deserialization of untrusted data",
      "handling": "Use safe formats and validation boundaries rather than blindly thawing arbitrary serialized data."
    },
    {
      "case": "module load order",
      "handling": "Account for compile-time effects of use, BEGIN blocks, and imports."
    },
    {
      "case": "fork portability",
      "handling": "Treat process-based concurrency as platform-dependent and validate deployment targets."
    },
    {
      "case": "signal handling",
      "handling": "Keep signal handlers simple and coordinate graceful shutdown through safe application state."
    }
  ],
  "constraints": [
    "The outline targets Perl 5 rather than Perl 6/Raku.",
    "Core Perl language features must be distinguished from CPAN modules and third-party frameworks.",
    "Operating-system behavior can vary by platform.",
    "Perl's context-sensitive semantics must be considered when analyzing expressions and subroutine interfaces.",
    "Unicode handling requires explicit attention to character and byte boundaries.",
    "Shell execution must not be treated as inherently safe.",
    "Third-party CPAN dependencies introduce compatibility and supply-chain considerations.",
    "Performance conclusions should be established through representative profiling rather than assumptions.",
    "Serialization formats have different compatibility and security properties.",
    "Object-oriented Perl can use several competing object systems and frameworks.",
    "Concurrency mechanisms differ substantially in portability, isolation, shared-state behavior, and operational complexity.",
    "Legacy Perl code may use idioms that modern Perl style discourages."
  ],
