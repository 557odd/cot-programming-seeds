              "statements",
              "blocks",
              "comments",
              "semicolon termination",
              "package declarations",
              "compile-time versus runtime behavior"
            ],
            "examples": [
              "use strict;",
              "use warnings;"
            ],
            "dependencies": [
              "syntax",
              "compilation model"
            ]
          },
          {
